# Copy to .env and fill in. On the NAS these are set via docker-compose.
DATABASE_URL="file:./dev.db"          # prod: file:/data/dagsverket.db
TZ="Europe/Stockholm"
ADMIN_PIN="choose-a-pin"              # hashed into the DB on first run
AUTH_SECRET="64-hex-chars"           # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
